# stage-b：SUSFS 2.3.0（非 GKI 5.4 回移）
#
# 依赖：KernelSU 侧 Kconfig 里加出来的 KSU_SUSFS（工作流运行时追加），
#       fs/susfs.Kconfig 由补丁带入并 source 进 fs/Kconfig。
#
# 打开的是 SUSFS 2.3.0 的九项能力，逐条对应要解决的检测面：
#   SUS_PATH      隐藏 /data/adb、/data/local/daidai 等路径
#   SUS_MOUNT     隐藏 SUSFS 自己挂的东西（容器 loop 设备也在这条链上）
#   SUS_KSTAT     伪造 stat 结果，抹掉 inode 归属差异
#   SPOOF_UNAME   把 5.4.254-qgki-gd2a1055adeb0 换成原厂串
#   ENABLE_LOG    出问题能查（刷成功后可以关）
#   HIDE_KSU_SUSFS_SYMBOLS  抹掉 kallsyms 里的 ksu/susfs 符号
#   SPOOF_CMDLINE_OR_BOOTCONFIG  改写 /proc/cmdline 的 orange/unlocked
#   OPEN_REDIRECT 路径重定向（给 keybox 之类用）
#   SUS_MAP       把可疑映射从 /proc/pid/maps 里摘掉
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
