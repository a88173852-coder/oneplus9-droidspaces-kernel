# Droidspaces 配置片段 —— 严格照抄官方 GKI 清单
# 来源: ravindu644/Droidspaces-OSS  Documentation/Kernel-Configuration.md
#       "GKI kernels (5.4 and newer)" 章节的 Step 2 配置块
# 该文档明确要求: "Do not turn on anything beyond them."
# 所以这里不加任何文档外的东西。
#
# 注意: CONFIG_CGROUP_DEVICE 只出现在该文档的 non-GKI(3.18~4.19) 清单里，
#       GKI 5.4 的配置块不含它，Requirements 检查表也不查它 —— 故此不开启。

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- 以下为官方标注 optional but recommended ---

# Fix for docker unsafe procfs error
CONFIG_USER_NS=y

# IPv6 in NAT mode (NAT66)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Macvlan mode (--net=macvlan)，容器可拿独立局域网 IP
CONFIG_MACVLAN=y

# UFW support
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# tmpfs 上的 xattr / posix acl（NixOS 需要）
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---------------------------------------------------------------------------
# 以下不属于 Droidspaces 清单，用途是「保持与原厂一致」
#
# 原因：本内核源码（2025 年快照）把 OPPO_* 系列配置项改名成了 OPLUS_*，
# 而我们的基线 config 取自手机（较旧的构建）。olddefconfig 时旧名全部失效、
# 新名取默认值 n，结果指纹驱动被静默关掉 —— 能开机，但指纹失效。
# 这里按改名后的新符号显式补齐。
# ---------------------------------------------------------------------------

# 指纹（原厂 CONFIG_OPPO_FINGERPRINT* -> 新树 CONFIG_OPLUS_FINGERPRINT*）
# COMMON 必须开：goodix / jiiov 驱动都调用它导出的
#   opticalfp_irq_handler_register / get_fpsensor_type
# 不开的话链接期直接 undefined symbol，vmlinux 生不出来。
CONFIG_OPLUS_FINGERPRINT=y
CONFIG_OPLUS_FINGERPRINT_COMMON=y
CONFIG_OPLUS_FINGERPRINT_QCOM=y
CONFIG_OPLUS_FINGERPRINT_GOODIX_OPTICAL=y
CONFIG_OPLUS_FINGERPRINT_JIIOV_OPTICAL=y

# 原厂开着：内核启动时自动挂载 devtmpfs 到 /dev
CONFIG_DEVTMPFS_MOUNT=y

# ---------------------------------------------------------------------------
# 绝对不要开启（官方原文: BREAK the kABI and no patch covers them）
# 这两个会改变 scheduler / cgroup 结构体大小，几千个导出符号 CRC 变化，
# 原厂预编译模块全部拒载 → 开不了机。除非能把厂商模块全部重编。
#   CONFIG_CFS_BANDWIDTH=y      -> 失去 --cpus，其余功能不受影响
#   CONFIG_CGROUP_PIDS=y        -> 失去 --pids-limit，其余功能不受影响
# 内存限制只需 CONFIG_MEMCG（原厂已开）。
# ---------------------------------------------------------------------------
